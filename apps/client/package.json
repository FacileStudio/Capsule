    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@facile/muse": "github:FacileStudio/muse#v0.4.0",
