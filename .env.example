# Required — the API refuses to start without it (tronc/env)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/capsule?sslmode=disable

# Override defaults only if needed
# APP_ENV=development
# PORT=4000
# LOG_LEVEL=info
# MAX_PASTE_SIZE=16777216

# CORS. Unset means no cross-origin caller is allowed, which is correct here:
# the SvelteKit client proxies /api/* server-side, so the browser never calls
# the API cross-origin. Legacy name ALLOWED_ORIGINS is still read as a fallback.
# CORS_ALLOWED_ORIGINS=https://capsule.facile.studio

# Single sign-on through Registre (optional; Capsule has no password path)
# OIDC_ISSUER=https://sso.facile.studio
# OIDC_CLIENT_ID=capsule
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://capsule.facile.studio/api/auth/oidc/callback
# OIDC_SUCCESS_URL=https://capsule.facile.studio
# OIDC_CLI_AUDIENCE=facile-cli  # mounts the device exchange so CLI device login works here; unset leaves it 404

# Journal log shipping (optional — per-app key from Journal's Keys page; Capsule is not on journal's docker network, so use the public URL https://journal.facile.studio/api)
# JOURNAL_URL=https://journal.facile.studio/api
# JOURNAL_TOKEN=journal_capsule_...
