# Override defaults only if needed
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/capsule?sslmode=disable
# PORT=4000
# LOG_LEVEL=info
# MAX_PASTE_SIZE=1048576
# ALLOWED_ORIGINS=*

# Journal log shipping (optional — per-app key from Journal's Keys page; Capsule is not on journal's docker network, so use the public URL https://journal.facile.studio/api)
# JOURNAL_URL=https://journal.facile.studio/api
# JOURNAL_TOKEN=journal_capsule_...
