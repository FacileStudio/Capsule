#!/usr/bin/env sh
#
# Quality gate, run before every push.
#
# Gates on the full check — Go modules and the client. The client reached zero
# svelte-check errors on 2026-08-07, so the --go-only escape hatch this hook
# used to carry is gone.
#
# Bypass once with:      git push --no-verify
# Enable in a clone with: git config core.hooksPath .githooks   (or mise run hooks)

set -eu
exec sh "$(git rev-parse --show-toplevel)/scripts/check.sh"
